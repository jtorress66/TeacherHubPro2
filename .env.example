# Copy to .env and fill in locally. Never commit .env files.

# Postgres. Matches docker-compose.yml for local development (`pnpm db:up`).
DATABASE_URL=postgres://teacherhub:teacherhub@localhost:5433/teacherhub

# Web app address and environment (development | test | production).
APP_URL=http://localhost:3000
APP_ENV=development

# Billing: `local` uses the in-app test checkout (development and test only), `stripe` uses Stripe.
BILLING_PROVIDER=local
LOCAL_BILLING_SECRET=change-me-local-billing-secret
# With BILLING_PROVIDER=stripe (test mode keys start with sk_test_ and whsec_):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Google sign-in: `local` uses an in-app test account picker (development and test only),
# `google` uses your Google OAuth client.
GOOGLE_AUTH_PROVIDER=local
LOCAL_GOOGLE_SECRET=change-me-local-google-secret
# With GOOGLE_AUTH_PROVIDER=google:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Lesson plan drafts: `local` uses a scripted stand-in (development and test), `anthropic` uses
# Claude. Without LLM_PROVIDER, a set ANTHROPIC_API_KEY means Claude. `pnpm eval` always uses Claude.
LLM_PROVIDER=local
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Read aloud: `local` is a silent stand-in (development and test), `openai` uses OpenAI
# text-to-speech in the worker. Without TTS_PROVIDER, a set OPENAI_API_KEY means OpenAI.
# The web app and the worker must use the same voice.
TTS_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=nova

# Google Classroom: `local` is a stand-in (development and test), `google` uses Google Classroom
# with the GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET above. TOKEN_ENCRYPTION_KEY (32 random bytes,
# base64) encrypts teachers' Classroom access at rest.
CLASSROOM_PROVIDER=local
# TOKEN_ENCRYPTION_KEY=

# Live games (Play to Learn): the realtime WebSocket server (`pnpm --filter @thp/realtime start`).
# The web app and the realtime server share REALTIME_TICKET_SECRET (32+ random characters) to sign
# and check the tickets that let a host or a student connect.
REALTIME_URL=http://localhost:3200
REALTIME_TICKET_SECRET=change-me-local-realtime-ticket-secret-123

# Email: `local` (the default until go-live) keeps sent mail in the database, readable at
# /en/dev/mail outside production. `resend` sends real mail with RESEND_API_KEY from MAIL_FROM, an
# address on a domain verified in Resend. The worker also needs APP_URL for links in reminders.
MAIL_PROVIDER=local
# RESEND_API_KEY=
# MAIL_FROM=TeacherHubPro <hello@example.com>
