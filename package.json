{
  "name": "teacherhubpro",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts --coverage",
    "test:e2e": "pnpm --filter @thp/web build && pnpm --filter @thp/web test:e2e",
    "eval": "node -e \"console.log('No evals yet.')\"",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check:forbidden": "node scripts/forbidden-terms.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @thp/worker migrate",
    "stripe:setup": "pnpm --filter @thp/worker stripe:setup",
    "test:e2e:stripe": "pnpm --filter @thp/web test:e2e:stripe"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testcontainers/postgresql": "12.2.1",
    "@thp/domain": "workspace:*",
    "@thp/i18n": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
